{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.qa/test-plan.schema.json",
  "title": "QA Test Plan",
  "description": "通用 QA 测试计划结构；只保存计划、范围、策略和执行准备信息。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "title",
    "status",
    "source_inputs",
    "trace",
    "objective",
    "scope",
    "strategy",
    "environment",
    "data",
    "roles",
    "dependencies",
    "priority",
    "risks",
    "open_questions",
    "entry_criteria",
    "exit_criteria",
    "evidence",
    "suites",
    "next_stage"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^TEST_PLAN-[A-Za-z0-9_-]+$",
      "description": "项目内唯一测试计划编号。"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "测试计划标题。"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "archived"]
    },
    "source_inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "description": "需求分析、配置和其他计划输入的相对路径。"
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["story", "req", "project", "version", "status"],
      "properties": {
        "story": {"type": ["string", "null"]},
        "req": {
          "type": "string",
          "pattern": "^REQ-[A-Za-z0-9_-]+$"
        },
        "project": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "status": {
          "type": "string",
          "enum": ["draft", "approved", "archived"]
        }
      }
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_scope"],
      "properties": {
        "in_scope": {
          "type": "array",
          "items": {"type": "string"}
        },
        "out_scope": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "strategy": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["client", "os", "browser", "base_url", "page_path", "portal_entry", "login"],
      "properties": {
        "client": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "browser": {"type": "string", "minLength": 1},
        "base_url": {"type": "string", "minLength": 1},
        "page_path": {"type": "string", "minLength": 1},
        "portal_entry": {"type": "string", "minLength": 1},
        "login": {"type": "string", "minLength": 1}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "preparation"],
      "properties": {
        "required": {
          "type": "array",
          "items": {"type": "string"}
        },
        "preparation": {"type": "string", "minLength": 1}
      }
    },
    "roles": {
      "type": "array",
      "items": {"type": "string"}
    },
    "dependencies": {
      "type": "array",
      "items": {"type": "string"}
    },
    "priority": {
      "type": "string",
      "minLength": 1
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "entry_criteria": {
      "type": "array",
      "items": {"type": "string"}
    },
    "exit_criteria": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence": {
      "type": "array",
      "items": {"type": "string"}
    },
    "suites": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Smoke", "Targeted", "Full"],
      "properties": {
        "Smoke": {"type": "string", "minLength": 1},
        "Targeted": {"type": "string", "minLength": 1},
        "Full": {"type": "string", "minLength": 1}
      }
    },
    "next_stage": {
      "const": "testcase-generation-agent"
    }
  }
}
