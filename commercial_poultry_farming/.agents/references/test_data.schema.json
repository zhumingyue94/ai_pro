{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/.agents/references/test_data.schema.json",
  "title": "UI Automation Test Data",
  "description": "通用 UI 自动化测试数据配置结构。",
  "type": "array",
  "minItems": 1,
  "items": {
    "$ref": "#/$defs/testCase"
  },
  "$defs": {
    "jsonValue": {},
    "testCase": {
      "type": "object",
      "required": ["caseId", "testData"],
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1
        },
        "testData": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/testDataItem"
          }
        }
      },
      "additionalProperties": true
    },
    "testDataItem": {
      "type": "object",
      "required": ["dataType", "data"],
      "properties": {
        "dataType": {
          "type": "string",
          "enum": [
            "precreated_normal",
            "precreated_special",
            "precreated_pagination",
            "input",
            "external_dependency",
            "runtime_create_cleanup",
            "no_business_data"
          ]
        },
        "data": {
          "$ref": "#/$defs/data"
        }
      },
      "additionalProperties": true
    },
    "data": {
      "type": "object",
      "properties": {
        "precreatedData": {
          "$ref": "#/$defs/precreatedData"
        },
        "externalDependency": {
          "$ref": "#/$defs/externalDependency"
        },
        "input": {
          "$ref": "#/$defs/jsonValue"
        },
        "provisioning": {
          "$ref": "#/$defs/provisioning"
        },
        "runtimeRules": {
          "$ref": "#/$defs/runtimeRules"
        },
        "cleanup": {
          "$ref": "#/$defs/cleanup"
        },
        "expectedDataState": {
          "$ref": "#/$defs/jsonValue"
        }
      },
      "additionalProperties": true
    },
    "precreatedData": {
      "type": "object",
      "properties": {
        "dataKey": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string"
        },
        "sort": {
          "type": ["number", "string"]
        },
        "status": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "minimumPages": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "externalDependency": {
      "type": "object",
      "properties": {
        "sourceModule": {
          "type": "string",
          "minLength": 1
        },
        "businessName": {
          "type": "string"
        },
        "relationRequired": {
          "$ref": "#/$defs/jsonValue"
        }
      },
      "required": ["sourceModule"],
      "additionalProperties": true
    },
    "provisioning": {
      "type": "object",
      "properties": {
        "whenMissing": {
          "type": "string"
        },
        "matchBy": {
          "type": "string"
        },
        "businessFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recordCreatedByTest": {
          "type": "boolean"
        },
        "onCreateFailure": {
          "type": "string"
        },
        "cleanupCreatedRecord": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "runtimeRules": {
      "type": "object",
      "properties": {
        "timestamp": {
          "type": "string"
        },
        "mustNotCreateRecord": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "cleanup": {
      "type": "object",
      "properties": {
        "restoreFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deleteCreatedRecord": {
          "type": "boolean"
        },
        "matchBy": {
          "$ref": "#/$defs/jsonValue"
        }
      },
      "additionalProperties": true
    }
  }
}
